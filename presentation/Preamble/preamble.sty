% --- TÙY BIẾN FOOTER (CHÂN TRANG) ---
\setbeamertemplate{footline}{
  \begin{beamercolorbox}[sep=3pt, wd=\paperwidth, leftskip=0.5cm, rightskip=0.5cm]{palette primary}
    \hspace{0.1cm}
    \scriptsize \insertsection \hfill 
    \insertframenumber{} / \inserttotalframenumber 
    \hspace{0.1cm}
  \end{beamercolorbox}
  \vskip2pt 
}

% --- PHẦN NÂNG CẤP: TỰ ĐỘNG HIỆN SLIDE TIÊU ĐỀ KHI ĐỔI SECTION ---
\AtBeginSection[]{
  \begin{frame}[plain]
    \centering
    \begin{tikzpicture}
        % Dùng màu BrandPrimary đã định nghĩa bên branding.tex
        \node[fill=BrandPrimary, text=white, rounded corners, inner sep=15pt, align=center, text width=0.8\paperwidth] at (0,0) {\Huge \bfseries \insertsection};
    \end{tikzpicture}
  \end{frame}
}

